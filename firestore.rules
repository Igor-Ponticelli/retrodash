rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isFacilitator(roomId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.role == "facilitator";
    }

    function isParticipant(roomId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid));
    }

    // existsAfter/getAfter variants for batch writes: exists() only sees pre-batch
    // state, so isFacilitator() returns false when the participant is being created
    // in the same batch as the room. These functions see the post-batch state.
    function isFacilitatorAfter(roomId) {
      return isAuth() &&
        existsAfter(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.role == "facilitator";
    }

    // Lets the author of a card delete comments left by other people when
    // they delete their own card (cascade delete), without granting them
    // any broader comment-moderation power.
    function isCardAuthor(roomId, cardId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/cards/$(cardId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)/cards/$(cardId)).data.authorId == request.auth.uid;
    }

    // ── Rooms ──────────────────────────────────────────────────────

    match /rooms/{roomId} {
      allow get: if isAuth();
      allow list: if isAuth() && resource.data.ownerId == request.auth.uid;

      allow create: if isAuth() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == "waiting" &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.password is string &&
        (
          (request.resource.data.isPublic && request.resource.data.password == "") ||
          (!request.resource.data.isPublic && request.resource.data.password.size() == 64)
        ) &&
        request.resource.data.isPublic is bool &&
        request.resource.data.isAnonymous is bool;

      allow update: if isFacilitator(roomId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'description']) &&
        request.resource.data.status in ["waiting", "active", "ended"] &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) ||
          (request.resource.data.description is string &&
           request.resource.data.description.size() <= 500)
        );

      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Columns ────────────────────────────────────────────────────

    match /rooms/{roomId}/columns/{columnId} {
      allow read: if isParticipant(roomId);
      allow write: if isFacilitator(roomId) || isFacilitatorAfter(roomId);
    }

    // ── Cards ──────────────────────────────────────────────────────

    match /rooms/{roomId}/cards/{cardId} {
      allow read: if isParticipant(roomId);

      allow create: if
        (isParticipant(roomId) || isFacilitatorAfter(roomId)) &&
        (
          request.resource.data.authorId == request.auth.uid ||
          // Carry-over writes the TRUE original author, who is often not
          // the person creating this new room. Scoped to the same trust
          // boundary already used for published == true below.
          (isFacilitatorAfter(roomId) && request.resource.data.carriedItem == true)
        ) &&
        request.resource.data.votes == 0 &&
        request.resource.data.votedBy == [] &&
        (
          request.resource.data.published == false ||
          (isFacilitatorAfter(roomId) && request.resource.data.published == true)
        ) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        (
          // Chain-tracking fields are only ever legitimately written by the
          // trusted createRoom() carry-over path, never by a regular
          // participant's addCard().
          isFacilitatorAfter(roomId) ||
          !request.resource.data.keys().hasAny(['returnCount', 'originRoomId', 'originCardId', 'carriedToRooms'])
        );

      allow update: if isParticipant(roomId) && (
        // Author edits own card text (published or draft) — locked once
        // this card was carried over from a past room (carriedItem: true),
        // permanently, regardless of who the recorded authorId is.
        (resource.data.authorId == request.auth.uid &&
         resource.data.get('carriedItem', false) != true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']) &&
         request.resource.data.text is string &&
         request.resource.data.text.size() > 0 &&
         request.resource.data.text.size() <= 2000)
        ||
        // Author publishes own draft (one-way: false → true only)
        (resource.data.authorId == request.auth.uid &&
         resource.data.published == false &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published', 'publishedAt']) &&
         request.resource.data.published == true)
        ||
        // Facilitator publishes/unpublishes any card
        (isFacilitator(roomId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published', 'publishedAt']) &&
         request.resource.data.published is bool)
        ||
        // Any participant sets actionStatus on a published card
        (resource.data.published == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actionStatus']) &&
         request.resource.data.actionStatus in ["pending", "done", "keep"])
        ||
        // Any participant sets or clears the assignee on a published action item.
        // Restricted to cards that already carry actionStatus (only action-item
        // cards get one), and the assignee must be a current room participant so
        // an arbitrary uid can't be written into assigneeId. All three fields
        // must change together (exact set, not hasOnly's subset) so a partial
        // update can't change assigneeId while leaving a stale assigneeName/
        // assigneePhotoURL from a previous assignee mismatched to the new id.
        // Locked once this card was carried over from a past room, same as
        // the text-edit branch above.
        (resource.data.published == true &&
         resource.data.get('carriedItem', false) != true &&
         resource.data.actionStatus is string &&
         request.resource.data.diff(resource.data).affectedKeys() == ['assigneeId', 'assigneeName', 'assigneePhotoURL'].toSet() &&
         (
           // Clearing: all three fields removed
           (!request.resource.data.keys().hasAny(['assigneeId', 'assigneeName', 'assigneePhotoURL']))
           ||
           // Setting: assigneeId must be an existing participant of this room
           (request.resource.data.assigneeId is string &&
            exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.assigneeId)) &&
            request.resource.data.assigneeName is string &&
            request.resource.data.assigneeName.size() > 0 &&
            request.resource.data.assigneeName.size() <= 200 &&
            (request.resource.data.assigneePhotoURL is string || request.resource.data.assigneePhotoURL == null) &&
            (request.resource.data.assigneePhotoURL == null || request.resource.data.assigneePhotoURL.size() <= 2000))
         ))
        ||
        // Any participant sets or clears the linked source card on a
        // published action item, after creation (retroactive linking).
        // linkedCardId must reference an existing card in this room.
        // Locked once carried over, same as text/assignee above.
        (resource.data.published == true &&
         resource.data.get('carriedItem', false) != true &&
         resource.data.actionStatus is string &&
         request.resource.data.diff(resource.data).affectedKeys() == ['linkedCardId', 'linkedCardText'].toSet() &&
         (
           // Clearing: both fields removed
           (!request.resource.data.keys().hasAny(['linkedCardId', 'linkedCardText']))
           ||
           // Setting: linkedCardId must reference an existing card in this room
           (request.resource.data.linkedCardId is string &&
            exists(/databases/$(database)/documents/rooms/$(roomId)/cards/$(request.resource.data.linkedCardId)) &&
            request.resource.data.linkedCardText is string &&
            request.resource.data.linkedCardText.size() > 0 &&
            request.resource.data.linkedCardText.size() <= 2000)
         ))
        ||
        // Any participant votes — set-based validation prevents forged vote counts
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy']) &&
         (
           // Adding own vote
           (request.resource.data.votedBy.toSet().difference(resource.data.votedBy.toSet()) == [request.auth.uid].toSet() &&
            resource.data.votedBy.toSet().difference(request.resource.data.votedBy.toSet()).size() == 0 &&
            request.resource.data.votes == resource.data.votes + 1)
           ||
           // Removing own vote
           (resource.data.votedBy.toSet().difference(request.resource.data.votedBy.toSet()) == [request.auth.uid].toSet() &&
            request.resource.data.votedBy.toSet().difference(resource.data.votedBy.toSet()).size() == 0 &&
            request.resource.data.votes == resource.data.votes - 1)
         ))
        ||
        // commentsCount bump, paired client-side with a comment create/delete
        // in the same batch. Not cross-validated against the specific comment
        // doc (the card's rule can't see which comment triggered it) — same
        // trust level as the votes counter above: worst case is a wrong badge
        // number, not a permission or data-visibility issue.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
         isParticipant(roomId) &&
         (
           request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1 ||
           request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1
         ))
        ||
        // Facilitator of THIS card's own room appends to its carriedToRooms
        // chain-tracking list when it (or a newer copy of it) is carried
        // into another room the same user also facilitates.
        // isFacilitator(roomId) here binds to this card's OWN room path
        // segment (the origin room), so it authorizes this write regardless
        // of which other room is currently being created elsewhere — safe
        // because a carry-over chain is always owned end-to-end by the same
        // single user today (carry-over sources are restricted to the
        // acting user's own ended rooms, and ownerId is immutable).
        (isFacilitator(roomId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carriedToRooms']) &&
         request.resource.data.carriedToRooms is list &&
         request.resource.data.carriedToRooms.size() >= resource.data.get('carriedToRooms', []).size())
      );

      allow delete: if isFacilitator(roomId) ||
        (isParticipant(roomId) &&
         resource.data.get('carriedItem', false) != true &&
         resource.data.authorId == request.auth.uid);
    }

    // ── Comments ───────────────────────────────────────────────────

    match /rooms/{roomId}/cards/{cardId}/comments/{commentId} {
      allow read: if isParticipant(roomId);

      allow create: if isParticipant(roomId) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500;

      // No update rule: comments are not editable.

      allow delete: if isFacilitator(roomId) ||
        resource.data.authorId == request.auth.uid ||
        isCardAuthor(roomId, cardId);
    }

    // ── Scoreboard ─────────────────────────────────────────────────
    // Recomputed and overwritten by whoever opens Summary (any participant,
    // not just the facilitator) — derived from cards/participants data the
    // same participants can already read, so no extra field validation.

    match /rooms/{roomId}/scoreboard/{docId} {
      allow read: if isParticipant(roomId);
      allow write: if isParticipant(roomId);
    }

    // ── Participants ───────────────────────────────────────────────

    match /rooms/{roomId}/participants/{participantId} {
      // participantId (doc ID) used instead of resource.data to handle non-existent docs
      allow read: if isAuth() && (
        participantId == request.auth.uid ||
        isParticipant(roomId)
      );

      // getAfter() validates the facilitator role is consistent with the room's ownerId
      // even when both documents are written in the same createRoom() batch
      allow create: if isAuth() &&
        participantId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 200 &&
        (
          request.resource.data.role == "member" ||
          (request.resource.data.role == "facilitator" &&
           getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid)
        );

      allow update: if isAuth() && (
        // User can refresh their own display name/photo (no role self-escalation)
        (participantId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']))
        ||
        // Facilitator can change participant roles
        (isFacilitator(roomId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
         request.resource.data.role in ["member", "facilitator"])
      );

      allow delete: if isAuth() && (
        participantId == request.auth.uid ||
        isFacilitator(roomId)
      );
    }

    // ── CollectionGroup: participants ─────────────────────────────
    // Required for the collectionGroup("participants") query in useJoinedRooms.
    // Must match on resource.data.userId (not participantId) so Firestore can
    // statically validate the where("userId","==",uid) query constraint.
    match /{path=**}/participants/{participantId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── CollectionGroup: cards ──────────────────────────────────────
    // Required for the collectionGroup("cards") query in getMyActionItems
    // (Navbar "my action items" list). Scoped to cards the caller is
    // assigned to — no broader cross-room card visibility is granted.
    match /{path=**}/cards/{cardId} {
      allow read: if isAuth() && resource.data.assigneeId == request.auth.uid;
    }

    // ── Feedback ───────────────────────────────────────────────────

    match /feedback/{feedbackId} {
      allow read: if false;

      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ["bug", "feature", "general"] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000 &&
        request.resource.data.userEmail is string &&
        request.resource.data.userEmail.size() <= 500;
    }
  }
}
